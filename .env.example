# Copy to .env (git ignores .env) and fill in. Without a .env the tool speaks with the macOS "Linh" voice.
# zerotts = local Vietnamese voice (see README: tts-env and models/zerotts); omnivoice = VoiceStudio server below; say = macOS Linh
TTS_PROVIDER=zerotts
# ZEROTTS_VOICE=maichi   # maichi, baotrang, giahuy, hamy, huuduc, kimoanh, quangminh, tiendat
OMNIVOICE_URL=http://192.168.1.8:3901
OMNIVOICE_VOICE=phat
# PIN of the VoiceStudio server (sent as X-OmniVoice-Pin). Never commit the real value.
OMNIVOICE_PIN=
# OMNIVOICE_STEPS=16
# Speech speed, 1.0 = normal. Default 1.15; above about 1.3 words start to blur.
# OMNIVOICE_SPEED=1.15
PORT=3150
# 0 = everyone wears the plain grey robe (no pink for the top six, no brown in the crowd). Default 1.
# COLOR_OUTFITS=1
# Name above a disciple's head: font size in px (10 to 48, default 16).
NAME_FONT_SIZE=16
# Seconds a name stays up when someone arrives, chats or finishes praying. 0 (default) = the built-in 2 to 5 s.
# Names during a prayer and on the six cushions always stay.
NAME_SHOW_SECONDS=0
# Opacity of the black box behind a disciple's name: 0 (no box) to 1 (solid black). Default 0.78.
NAME_PLATE_OPACITY=0.78
