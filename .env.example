# Copy to .env (git ignores .env) and fill in. Without a .env the tool speaks with the macOS "Linh" voice.
TTS_PROVIDER=omnivoice
OMNIVOICE_URL=http://192.168.1.8:3901
OMNIVOICE_VOICE=phat
# PIN of the VoiceStudio server (sent as X-OmniVoice-Pin). Never commit the real value.
OMNIVOICE_PIN=
# OMNIVOICE_STEPS=16
# Speech speed, 1.0 = normal. Default 1.15; above about 1.3 words start to blur.
# OMNIVOICE_SPEED=1.15
PORT=3150
